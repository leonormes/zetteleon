{
	"schemaVersion": "0.1.0",
	"name": "PRODOS Web Capture",
	"behavior": "create",
	"noteContentFormat": "## {{title}}\n\n{{content}}\n",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "captured",
			"value": "{{time}}",
			"type": "text"
		},
		{
			"name": "status",
			"value": "seed",
			"type": "text"
		},
		{
			"name": "type",
			"value": "concept",
			"type": "text"
		},
		{
			"name": "conformant",
			"value": "false",
			"type": "checkbox"
		},
		{
			"name": "non_conformance_reason",
			"value": "raw web capture awaiting triage",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "source/web-clip",
			"type": "multitext"
		}
	],
	"triggers": [],
	"noteNameFormat": "Clip - {{title}}",
	"path": "00_Inbox"
}
