filters:
  and:
    - file.folder == "30_Library/200_Projects"
    - status != "archived"
views:
  - type: table
    name: Table
    groupBy:
      property: project_name
      direction: ASC
    order:
      - file.name
      - project_name
      - type
      - conformant
    sort:
      - property: project_name
        direction: ASC
    columnSize:
      file.name: 500
      note.project_name: 200
  - type: table
    name: Archived References
    filters:
      and:
        - status == "archived"
