filters:
  and:
    - or:
        - type == "head"
        - type == "HEAD"
    - status != "archived"
    - '!file.path.startsWith("10_System")'
views:
  - type: table
    name: All Open
    filters: status != "someday"
    order:
      - file.name
      - status
      - AoL
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 420
  - type: table
    name: Active Work HEADs
    filters:
      and:
        - AoL == "Work"
        - or:
            - status == "active"
            - status == "processing"
    order:
      - file.name
      - status
      - type
      - AoL
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 580
      status: 127
  - type: table
    name: Active Personal HEADs
    filters:
      and:
        - AoL == "Personal"
        - or:
            - status == "active"
            - status == "processing"
    order:
      - file.name
      - status
      - type
      - AoL
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 580
      status: 127
  - type: table
    name: Someday
    filters: status == "someday"
    order:
      - file.name
      - status
      - AoL
    sort:
      - property: file.ctime
        direction: DESC
