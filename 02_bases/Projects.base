filters:
  and:
    - file.path.contains("200_Projects")
    - file.ext == "md"
    - type != "dashboard"
views:
  - type: table
    name: 🗂️ All Projects
    order:
      - file.name
      - project_name
      - project_status
      - file.mtime
    sort:
      - property: project_name
        direction: ASC
      - property: project_status
        direction: ASC
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 598
      note.project_name: 180
      note.project_status: 140
  - type: table
    name: 🟢 Active Projects
    filters:
      and:
        - project_status == "active"
    order:
      - file.name
      - project_name
      - project_category
      - tags
      - file.mtime
    sort:
      - property: project_name
        direction: ASC
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 380
      note.project_name: 180
      note.project_category: 150
      note.tags: 200
  - type: table
    name: 📦 By Parent Project
    filters:
      and:
        - project_name != ""
    order:
      - project_name
      - file.name
      - project_category
      - project_status
      - file.mtime
    sort:
      - property: project_name
        direction: ASC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.project_name: 180
      file.name: 360
      note.project_category: 150
      note.project_status: 110
  - type: table
    name: 🏗️ Deployments & Infrastructure
    filters:
      or:
        - project_category == "deployments"
        - project_category == "refined_deployment"
    order:
      - file.name
      - project_name
      - project_category
      - project_status
      - tags
      - file.mtime
    sort:
      - property: project_category
        direction: ASC
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 380
      note.project_name: 180
      note.project_category: 160
      note.tags: 200
  - type: table
    name: 🔧 Refined Deployment
    filters:
      and:
        - project_name == "Refined Deployment"
    order:
      - file.name
      - type
      - status
      - tags
      - file.mtime
      - file.size
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 380
      note.type: 110
      note.status: 120
      note.tags: 200
  - type: table
    name: 🧠 ProdOS & Practices
    filters:
      or:
        - project_category == "prodos"
        - type == "practice"
    order:
      - file.name
      - type
      - project_status
      - status
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 400
      note.type: 110
      note.project_status: 110
      note.status: 120
  - type: table
    name: 🎓 Bessie Education
    filters:
      and:
        - project_name == "Bessie"
    order:
      - file.name
      - type
      - file.mtime
      - file.size
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 450
      note.type: 110
  - type: table
    name: 🔥 Recently Modified
    filters:
      and:
        - file.mtime > now() - "14 days"
    order:
      - file.name
      - type
      - project_name
      - project_status
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 360
      note.type: 110
      note.project_name: 180
      note.project_status: 110
