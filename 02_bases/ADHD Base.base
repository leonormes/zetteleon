filters:
  and:
    - file.ext == "md"
    - file.tags.contains("adhd")
    - '!file.folder.startsWith("99_Archive")'
views:
  - type: table
    name: Table
    order:
      - type
      - file.name
      - status
      - file.tags
      - file.size
    sort:
      - property: file.name
        direction: ASC
      - property: file.size
        direction: DESC
      - property: type
        direction: ASC
    columnSize:
      note.type: 99
      file.name: 581
