filters:
  and:
    - type.contains("sot")
    - '!file.path.startsWith("99")'
views:
  - type: table
    name: Table
    order:
      - file.name
      - tier
      - type
      - trust-level
    sort:
      - property: tier
        direction: ASC
      - property: trust-level
        direction: ASC
      - property: tags
        direction: ASC
      - property: type
        direction: DESC
    columnSize:
      file.name: 432
