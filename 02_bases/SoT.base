filters:
  and:
    - type.contains("sot")
    - '!file.path.startsWith("99")'
views:
  - type: table
    name: Table
    order:
      - file.name
      - type
      - tags
    sort:
      - property: type
        direction: ASC
      - property: file.name
        direction: ASC
      - property: created
        direction: DESC
    columnSize:
      file.name: 432
