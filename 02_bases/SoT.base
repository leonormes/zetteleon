filters:
  and:
    - or:
        - type == "sot"
        - type == "protocol"
    - status != "archived"
views:
  - type: table
    name: All Active SoTs & Protocols
    order:
      - file.name
      - type
      - status
      - conformant
    sort:
      - property: type
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 432
  - type: table
    name: Non-Conformant Review
    filters:
      and:
        - conformant == false
    order:
      - file.name
      - type
      - non_conformance_reason
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Archived
    filters:
      and:
        - status == "archived"
