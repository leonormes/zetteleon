filters:
  and:
    - file.inFolder("00_Inbox")
views:
  - type: list
    name: Table
    order:
      - file.name
      - tags
    sort:
      - property: tags
        direction: ASC
    columnSize:
      file.name: 469
    indentProperties: false
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("00_Inbox/Readwise")
