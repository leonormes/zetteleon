filters:
  and:
    - file.inFolder("00_Inbox")
views:
  - type: table
    name: Table
    order:
      - file.name
      - tags
      - file.path
    sort:
      - property: file.ctime
        direction: ASC
    columnSize:
      file.name: 672
    indentProperties: false
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("00_Inbox/Readwise")
