views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "10_System/prompts"
    order:
      - file.name
      - version
      - purpose
    sort:
      - property: file.ctime
        direction: DESC
    properties:
      note.purpose:
        wrap: true
    columnSize:
      file.name: 350
      note.purpose: 917
