views:
  - type: table
    name: All Prompts
    filters:
      and:
        - file.folder == "10_System/prompts"
    order:
      - file.name
      - description
    sort:
      - property: description
        direction: ASC
      - property: file.ctime
        direction: DESC
    properties:
      tags:
        width: 200
      description:
        width: 420
    columnSize:
      file.name: 345
  - type: table
    name: Personas
    filters:
      and:
        - file.folder == "10_System/prompts"
        - file.tags.contains("type/persona")
    order:
      - file.name
    properties:
      tags:
        width: 200
      description:
        width: 420
  - type: table
    name: Protocols
    filters:
      and:
        - file.folder == "10_System/prompts"
        - file.tags.contains("type/protocol")
    order:
      - file.name
    properties:
      tags:
        width: 200
      description:
        width: 420
  - type: table
    name: Systems
    filters:
      and:
        - file.folder == "10_System/prompts"
        - file.tags.contains("type/system")
    order:
      - file.name
    properties:
      tags:
        width: 200
      description:
        width: 420
  - type: table
    name: Contexts
    filters:
      and:
        - file.folder == "10_System/prompts"
        - file.tags.contains("type/context")
    order:
      - file.name
    properties:
      tags:
        width: 200
      description:
        width: 420
  - type: table
    name: Utilities
    filters:
      and:
        - file.folder == "10_System/prompts"
        - file.tags.contains("type/utility")
    order:
      - file.name
    properties:
      tags:
        width: 200
      description:
        width: 420
