filters:
  and:
    - file.hasTag("task")
    - file.hasTag("archived") != true
    - status != "done"
    - or:
        - status == "waiting"
        - list(contexts).contains("waiting")
        - list(contexts).contains("@waiting")
        - file.hasTag("waiting")
formulas:
  daysWaiting: (now() - file.mtime).days.round(0)
  daysUntilDue: if((due.isEmpty() == false), ((number(date(due)) - number(today())) / 86400000).floor(), null)
  isOverdue: (due.isEmpty() == false) && date(due) < today()
properties:
  note.status:
    displayName: Status
  note.priority:
    displayName: Priority
  note.due:
    displayName: Due
  note.scheduled:
    displayName: Scheduled
  note.projects:
    displayName: Projects
  note.contexts:
    displayName: Contexts
  note.blockedBy:
    displayName: Blocked By
  formula.daysWaiting:
    displayName: Days Since Touch
views:
  - type: tasknotesTaskList
    name: Waiting For by Project
    groupBy:
      property: projects
      direction: ASC
    order:
      - status
      - priority
      - due
      - scheduled
      - projects
      - contexts
      - blockedBy
      - formula.daysWaiting
      - file.tags
      - file.tasks
    sort:
      - property: due
        direction: ASC
      - property: file.mtime
        direction: ASC
