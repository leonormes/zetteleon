filters:
  and:
    - type == "map"
    - status != "archived"
views:
  - type: table
    name: Active Maps
    order:
      - file.name
      - status
      - conformant
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 450
  - type: list
    name: Recently Updated
    filters:
      and:
        - file.mtime > now() - "30 days"
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Stale Maps
    filters:
      and:
        - file.mtime < now() - "6 months"
    order:
      - file.name
      - file.mtime
      - status
    sort:
      - property: file.mtime
        direction: ASC
  - type: table
    name: Non-Conformant
    filters:
      and:
        - conformant == false
    order:
      - file.name
      - non_conformance_reason
