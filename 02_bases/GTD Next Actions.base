filters:
  and:
    - file.hasTag("task")
    - file.hasTag("archived") != true
    - or:
        - status == "open"
        - status == "next"
    - or:
        - blockedBy.isEmpty()
        - list(blockedBy).filter(file(if(value.isType("object"), value.uid, value)).properties.status != "done").isEmpty()
formulas:
  priorityWeight: if(priority=="none",0,if(priority=="low",1,if(priority=="normal",2,if(priority=="high",3,-1))))
  daysUntilDue: if((due.isEmpty() == false), ((number(date(due)) - number(today())) / 86400000).floor(), null)
  daysUntilScheduled: if((scheduled.isEmpty() == false), ((number(date(scheduled)) - number(today())) / 86400000).floor(), null)
  nextDate: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), if(date(due) < date(scheduled), due, scheduled), if((due.isEmpty() == false), due, scheduled))
  daysUntilNext: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), min(formula.daysUntilDue, formula.daysUntilScheduled), if((due.isEmpty() == false), formula.daysUntilDue, formula.daysUntilScheduled))
  urgencyScore: if(due.isEmpty() && scheduled.isEmpty(), formula.priorityWeight, formula.priorityWeight + max(0, 10 - if(formula.daysUntilNext, formula.daysUntilNext, 0)) + (1 - ((number(date(formula.nextDate)) - number(date(date(formula.nextDate).format("YYYY-MM-DD")))) / 86400000)))
  actionScope: if(projects.isEmpty(), "Standalone", "Project")
properties:
  note.status:
    displayName: Status
  note.priority:
    displayName: Priority
  note.due:
    displayName: Due
  note.scheduled:
    displayName: Scheduled
  note.projects:
    displayName: Projects
  note.contexts:
    displayName: Contexts
  note.blockedBy:
    displayName: Blocked By
  formula.actionScope:
    displayName: Scope
  formula.urgencyScore:
    displayName: Urgency
views:
  - type: tasknotesTaskList
    name: Next Actions by Context
    groupBy:
      property: contexts
      direction: ASC
    order:
      - status
      - priority
      - due
      - scheduled
      - projects
      - contexts
      - formula.actionScope
      - file.tags
      - blockedBy
      - file.tasks
    sort:
      - property: formula.urgencyScore
        direction: DESC
  - type: tasknotesTaskList
    name: Project Next Actions
    filters:
      and:
        - projects.isEmpty() == false
    groupBy:
      property: contexts
      direction: ASC
    order:
      - status
      - priority
      - due
      - scheduled
      - projects
      - contexts
      - file.tags
      - file.tasks
    sort:
      - property: formula.urgencyScore
        direction: DESC
  - type: tasknotesTaskList
    name: Standalone Actions
    filters:
      and:
        - projects.isEmpty()
    groupBy:
      property: contexts
      direction: ASC
    order:
      - status
      - priority
      - due
      - scheduled
      - contexts
      - file.tags
      - file.tasks
    sort:
      - property: formula.urgencyScore
        direction: DESC
