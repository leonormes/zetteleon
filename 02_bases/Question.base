filters:
  and:
    - type == "question"
views:
  - type: table
    name: Question
    order:
      - file.name
      - tension
      - candidate_answers
      - related_claims
      - title
      - type
      - project_name
      - project_category
      - status
      - tags
      - conformant
      - non_conformance_reason
      - supersedes
      - superseded_by
      - prodos
    columnSize:
      file.name: 806
