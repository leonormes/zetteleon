filters:
  and:
    - type == "claim"
views:
  - type: table
    name: claim
    groupBy:
      property: conformant
      direction: DESC
    order:
      - file.name
      - proposition
      - epistemic_status
      - evidence_links
      - contradicts
      - title
      - type
      - project_name
      - project_category
      - status
      - tags
      - conformant
      - non_conformance_reason
      - supersedes
      - superseded_by
      - prodos
