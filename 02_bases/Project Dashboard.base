filters:
  and:
    - file.ext == "md"
    - type == "project"
    - status != "archived"
views:
  - type: table
    name: Active Projects Review
    groupBy:
      property: project_category
      direction: ASC
    order:
      - file.name
      - project_name
      - project_category
      - status
      - conformant
    sort:
      - property: project_name
        direction: ASC
    columnSize:
      file.name: 350
      note.project_name: 250
  - type: cards
    name: Visual Board
    order:
      - status
      - project_name
      - file.name
  - type: table
    name: Non-Conformant
    filters:
      and:
        - conformant == false
    order:
      - file.name
      - project_name
      - non_conformance_reason
