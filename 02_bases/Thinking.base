filters:
  and:
    - type == "question"
    - file.ext == "md"
formulas:
  days_stale: (now() - file.mtime).days.round(0)
  stale_flag: if((now() - file.mtime).days > 90 && status == "open", "⚠️ >90d Stale", "✅ Active")
properties:
  note.AoL:
    displayName: Area
  note.closing_condition:
    displayName: Has Exit?
  note.status:
    displayName: Status
  note.tension:
    displayName: Tension
  note.candidate_answers:
    displayName: Candidate Answers
  note.related_claims:
    displayName: Related Claims
  note.sources:
    displayName: Sources
  formula.days_stale:
    displayName: Days Since Touch
  formula.stale_flag:
    displayName: Health
views:
  - type: kanban
    name: Workbench Board
    filters:
      and:
        - '!file.inFolder("99_Archive")'
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - open
      - thinking
      - resolved
    order:
      - file.name
      - AoL
      - tension
      - closing_condition
      - formula.days_stale
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: Think about this
    filters:
      and:
        - status == "open"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - tension
      - candidate_answers
      - related_claims
      - AoL
      - formula.days_stale
      - formula.stale_flag
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
    summaries:
      formula.days_stale: Average
    columnSize:
      file.name: 667
      file.mtime: 130
  - type: table
    name: Personal
    filters:
      and:
        - AoL == "Personal"
        - status != "resolved"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - tension
      - candidate_answers
      - related_claims
      - status
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
    columnSize:
      file.name: 540
      tension: 640
  - type: table
    name: Work
    filters:
      and:
        - AoL == "Work"
        - status != "resolved"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - tension
      - candidate_answers
      - related_claims
      - status
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
    columnSize:
      file.name: 540
      tension: 640
  - type: table
    name: Vault & tooling
    filters:
      and:
        - AoL == "System"
        - status != "resolved"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - tension
      - candidate_answers
      - related_claims
      - status
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
    columnSize:
      file.name: 540
      tension: 640
  - type: table
    name: No exit condition
    filters:
      and:
        - closing_condition == false
        - status != "resolved"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - tension
      - AoL
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
    columnSize:
      file.name: 620
  - type: table
    name: In progress
    filters:
      and:
        - status == "thinking"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - tension
      - candidate_answers
      - related_claims
      - AoL
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 540
  - type: table
    name: Ready for Chronos
    filters:
      or:
        - status == "resolved"
        - file.inFolder("99_Archive")
    order:
      - file.name
      - tension
      - related_claims
      - sources
      - AoL
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 540
  - type: table
    name: Non-compliant
    filters:
      and:
        - status != "resolved"
        - '!file.inFolder("99_Archive")'
        - non_conformance_reason != "quick capture — awaiting clarification"
        - or:
            - conformant == false
            - type != "question"
            - '!file.name.endsWith("?")'
    order:
      - file.name
      - type
      - conformant
      - non_conformance_reason
      - status
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 560
  - type: table
    name: Everything
    order:
      - file.name
      - status
      - AoL
      - closing_condition
      - tension
      - candidate_answers
      - related_claims
      - sources
      - supersedes
      - superseded_by
      - file.ctime
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 500
